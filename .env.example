# ── Vibe Meter environment variables ─────────────────────────────────

# Secret used to sign login sessions. Set this to any long random string.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# ── Shared storage (free) ────────────────────────────────────────────
# So you and your friend see each other's vibes, the app needs a shared
# key/value store. The easiest free option is Upstash Redis / Vercel KV.
#
# In Vercel:  Project ➜ Storage ➜ Create / Connect ➜ Upstash (KV / Redis)
# Vercel will automatically inject these variables for you. You can also
# paste them in manually from an Upstash database:
#
# (Vercel KV naming)
KV_REST_API_URL=
KV_REST_API_TOKEN=
#
# (or Upstash naming — either pair works)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Without these the app still runs, but vibes are only stored in memory
# on a single server instance (fine for local dev, not shared between users).
